# Production. Copy to .env next to docker-compose.yml and fill every value in.
#
#   docker compose -f docker-compose.yml -f docker-compose.prod.yml up -d
#
# Nothing here has a safe default, which is the point: the overlay declares
# these as required, so a missing one fails the `up` instead of falling back to
# the development credentials published in this repository.
#
# The API additionally refuses to start on a dangerous configuration — an unset
# or short signing key, debug mode, the repository's own database credentials,
# or a CORS origin that is a wildcard, plaintext, or localhost. It reports all
# of them at once, so one restart tells you everything that is wrong.

# --- Database ---------------------------------------------------------------
POSTGRES_USER=ifrs18_app
POSTGRES_PASSWORD=                     # generate: openssl rand -base64 36
POSTGRES_DB=ifrs18

# --- API --------------------------------------------------------------------
# generate: openssl rand -base64 48 — at least 32 characters.
# Changing it invalidates every session, so treat it as a rotation, not a redeploy.
IFRS18_AUTH_SECRET_KEY=

# The web app's origin, https, comma-separated if there is more than one.
# Uploads and exports carry the client's financial statements.
IFRS18_CORS_ORIGINS=https://ifrs18.example.com

IFRS18_LOG_LEVEL=INFO

# How long an uploaded source document is kept (spec §32). Note that audit log
# rows are append-only by database trigger and are NOT covered by this: a
# retention policy for them is a deliberate, separate decision.
IFRS18_UPLOAD_RETENTION_DAYS=30

# --- AI assistant (optional, spec §1) ---------------------------------------
# Leave false and the product works exactly as specified: every line a rule
# cannot decide reaches a qualified person, which is where it was going anyway.
IFRS18_AI_ENABLED=false
IFRS18_AI_API_KEY=

# --- Web --------------------------------------------------------------------
# The API's origin as the browser reaches it, https.
NEXT_PUBLIC_API_URL=https://api.ifrs18.example.com
