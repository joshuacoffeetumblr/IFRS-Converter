# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
dist/
build/
*.egg-info/

# Node
node_modules/
.next/
out/
.turbo/
*.tsbuildinfo

# Environment & secrets. Deny everything, then allow the templates by name:
# a new .env.<something> is a real file with real secrets far more often
# than it is an example, so the default has to be ignore.
.env
.env.*
!.env.example
!.env.production.example

# Uploaded / generated financial data — never commit client statements
uploads/
exports/
tmp/
*.xlsx
*.xls
*.csv
*.pdf
!docs/**/*.pdf
!tests/fixtures/**

# OS / editor
.DS_Store
.idea/
.vscode/

# Next.js / Playwright artifacts
next-env.d.ts
frontend/.next/
frontend/playwright-report/
frontend/test-results/

# Local database data
pgdata/

# `next dev` writes these agent-instruction files into frontend/ on every run.
# They are tool output, not source, so they are ignored rather than committed.
frontend/AGENTS.md
frontend/CLAUDE.md
