# Copy to .env for local development. Never commit a real .env (spec §31).

IFRS18_ENVIRONMENT=local
IFRS18_DEBUG=true
IFRS18_LOG_LEVEL=DEBUG
IFRS18_API_PREFIX=/api

IFRS18_DATABASE_URL=postgresql+asyncpg://ifrs18:ifrs18@localhost:5432/ifrs18
IFRS18_CORS_ORIGINS=http://localhost:3000

# --- Classification thresholds (spec §11) -----------------------------------
# Snapshotted onto each project at classification time, so changing these never
# retroactively alters an already-finalized analysis.
IFRS18_CLASSIFICATION_HIGH_CONFIDENCE_MIN=0.95
IFRS18_CLASSIFICATION_MEDIUM_CONFIDENCE_MIN=0.80
IFRS18_CLASSIFICATION_MATERIALITY_FLOOR_PCT_OF_REVENUE=0.1

# --- Reconciliation tolerances (spec §19) -----------------------------------
# Non-zero only because source documents round. Total invariance has no
# tolerance and is not configurable.
IFRS18_RECONCILIATION_PROFIT_BEFORE_TAX_TOLERANCE=1
IFRS18_RECONCILIATION_SUBTOTAL_TOLERANCE=1

# --- Uploads (spec §31, §32) ------------------------------------------------
IFRS18_UPLOAD_MAX_BYTES=26214400
IFRS18_UPLOAD_RETENTION_DAYS=30

# --- AI assistant (spec §1 layer 2, §12) ------------------------------------
# Off unless BOTH the switch and a key are set. The product is defined to work
# without it: anything a rule cannot decide goes to a person either way, so the
# assistant only changes whether that person starts from a blank line or from a
# proposal they have to check. It can never finalize a classification.
# Requires the `ai` extra: pip install -e ".[ai]"
IFRS18_AI_ENABLED=false
# IFRS18_AI_API_KEY=sk-ant-...        # or the SDK's own ANTHROPIC_API_KEY
IFRS18_AI_MODEL=claude-opus-5
IFRS18_AI_EFFORT=medium
IFRS18_AI_TIMEOUT_SECONDS=30
# One repair round trip on invalid output (spec §12). A second mostly buys
# latency: if the model could not satisfy a schema after being shown the error,
# a human is the better next step.
IFRS18_AI_REPAIR_ATTEMPTS=1

# --- Auth (spec §31) --------------------------------------------------------
# Unset locally, which generates a key per process: every restart invalidates
# tokens, which is harmless. In production it is required — the API refuses to
# start without it rather than accept tokens anyone could mint.
# IFRS18_AUTH_SECRET_KEY=

# --- Frontend ---------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000
